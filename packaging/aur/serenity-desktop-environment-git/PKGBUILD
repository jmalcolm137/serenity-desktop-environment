# Maintainer: Serenity Desktop Environment contributors
#
# The compositor, services and session half of the split. It builds against the
# framework package (serenity-lagom-git) with SDE_PREBUILT_FRAMEWORK=ON, and
# installs only its own binaries/scripts; the framework package owns bin/lib/share.

pkgname=serenity-desktop-environment-git
pkgver=r478.dbecdd2
pkgrel=1
pkgdesc="The SerenityOS desktop experience on Wayland (compositor, shell and services)"
arch=('x86_64')
url="https://github.com/jmalcolm137/serenity-desktop-environment"
license=('BSD-2-Clause')
provides=('serenity-desktop-environment')
conflicts=('serenity-desktop-environment')
depends=(
    'serenity-lagom-git'
    wayland libdrm libinput libxkbcommon pixman libseat libxcb xcb-util-wm
    libdisplay-info pipewire libpipewire dbus glib2 fontconfig freetype2
    libunwind libelf libei xorg-xwayland
)
makedepends=(
    'serenity-lagom-git'
    base-devel cmake ninja meson pkgconf git python wayland-protocols
    libpulse zip unzip
)
source=(
    "serenity-desktop-environment::git+https://github.com/jmalcolm137/serenity-desktop-environment.git"
)
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/serenity-desktop-environment"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/serenity-desktop-environment"
    export SDE_PREBUILT_FRAMEWORK=ON
    export SDE_LAGOM_BUILD_DIR=/usr/lib/sde
    export SDE_SERENITY_BUILD_DIR=/usr/lib/sde/framework
    export SDE_SERENITY_SRC=/usr/lib/sde/framework/serenity
    export SDE_LIBGUI_WAYLAND_ROOT=/usr/lib/sde/framework
    export SERENITY_SRC="$SDE_SERENITY_SRC"
    export BUILD="$SDE_LAGOM_BUILD_DIR"
    export WLROOTS_SRC="$srcdir/serenity-desktop-environment/third_party/wlroots"
    scripts/build-full-sde.sh
}

package() {
    cd "$srcdir/serenity-desktop-environment"
    export BUILD=/usr/lib/sde
    export SERENITY=/usr/lib/sde/framework/serenity
    scripts/install-sde.sh --destdir "$pkgdir" --prefix /usr/lib/sde --without-framework

    # The compositor links the wlroots the SDE fetched and built.
    install -d "$pkgdir/usr/lib/sde/lib"
    cp -a "$srcdir/serenity-desktop-environment/third_party/wlroots/install/lib/"*.so* "$pkgdir/usr/lib/sde/lib/"
}
