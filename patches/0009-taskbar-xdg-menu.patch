+namespace Taskbar::Xdg {
+
+// The parts of the freedesktop Desktop Entry and Menu specifications the
+// Taskbar's XDG menu needs. See docs/36-xdg-desktop-menu.md.
+
+struct DesktopEntry {
+    // The desktop-file id: the path below the app dir, with '/' replaced by
+    // '-' (and the ".desktop" suffix kept), as the menu spec defines it.
+    ByteString id;
+    ByteString path;
+    ByteString name;
+    ByteString comment;
+    ByteString icon;
+    ByteString exec;
+    ByteString executable;
+    ByteString url;
+    Vector<ByteString> categories;
+    bool terminal { false };
+    bool is_link { false };
+};
+
+struct Rule {
+    enum class Type {
+        Never,
+        All,
+        And,
+        Or,
+        Not,
+        Category,
+        Filename,
+    };
+
+    Type type { Type::Never };
+    ByteString value;
+    Vector<Rule> children;
+
+    bool matches(DesktopEntry const&) const;
+};
+
+struct Query {
+    bool exclude { false };
+    Vector<Rule> rules;
+};
+
+struct LayoutItem {
+    enum class Type {
+        Entry,
+        Menu,
+        Separator,
+        MergeMenus,
+        MergeFiles,
+        MergeAll,
+    };
+
+    Type type;
+    ByteString value;
+    bool show_empty { false };
+};
+
+struct Layout {
+    Vector<LayoutItem> items;
+    bool show_empty { false };
+};
+
+struct DirectoryInfo {
+    ByteString name;
+    ByteString comment;
+    ByteString icon;
+};
+
+struct MenuNode {
+    ByteString name;
+    Vector<ByteString> app_dirs;
+    Vector<ByteString> directory_dirs;
+    Vector<ByteString> directory_ids;
+    Vector<Query> queries;
+    struct Move {
+        Vector<ByteString> old_path;
+        Vector<ByteString> new_path;
+    };
+    Vector<Move> moves;
+    Vector<NonnullOwnPtr<MenuNode>> children;
+    Optional<Layout> layout;
+    Optional<Layout> default_layout;
+    Optional<DirectoryInfo> directory;
+    bool only_unallocated { false };
+    bool only_unallocated_set { false };
+    bool deleted { false };
+    bool deleted_set { false };
+
+    // Filled by the query phase; the entries shown directly in this menu.
+    Vector<DesktopEntry> entries;
+};
+
+struct LoadedMenu {
+    NonnullOwnPtr<MenuNode> root;
+    ByteString path;
+};
+
+// Locates and loads the session's menu file. A null result means no menu file
+// was found anywhere (the caller can then use its built-in fallback).
+ErrorOr<OwnPtr<LoadedMenu>> load_menu();
+
+// The desktop entry and Exec helpers, also used by the menu builder.
+Optional<DesktopEntry> read_desktop_entry(ByteString const& path, ByteString const& id);
+Vector<DesktopEntry> discover_entries();
+Optional<ByteString> resolve_executable(StringView program);
+Vector<ByteString> split_exec(StringView exec);
+ByteString strip_field_codes(StringView exec);
+
+// The desktop directory entries (.directory).
+Optional<DirectoryInfo> read_directory_entry(ByteString const& path);
+ByteString localized_value(Core::ConfigFile const&, StringView group, StringView key);
+
+}
