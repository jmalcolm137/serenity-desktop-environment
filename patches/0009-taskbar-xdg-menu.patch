@@ -0,0 +1,525 @@
+/*
+ * Copyright (c) 2026, Serenity Desktop Environment contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// The Taskbar's XDG menu: instead of the Serenity .af applications, build the
+// system menu from the freedesktop menu file (${XDG_MENU_PREFIX}applications.menu)
+// and the .desktop entries it selects. Enabled by WindowServer.ini
+// [Taskbar] XDGMenu=true (default: the Serenity .af menu).
+//
+// The menu file's <Include>/<Exclude> rules, merging, .directory entries and
+// layout hints are handled in XdgMenuFile.cpp; this file turns the resolved tree
+// into GUI menus and launches entries. Entries for the Serenity applications are
+// generated from their .af files by scripts/generate-desktop-entries.sh.
+//
+// With no menu file anywhere the old flat category menu is used as a fallback,
+// so XDGMenu=true never leaves the Taskbar without a system menu.
+
+#include "XdgMenu.h"
+#include "XdgMenuFile.h"
+
+#include <AK/Array.h>
+#include <AK/Debug.h>
+#include <AK/HashTable.h>
+#include <AK/Optional.h>
+#include <AK/QuickSort.h>
+#include <AK/StringBuilder.h>
+#include <AK/StringView.h>
+#include <AK/Try.h>
+#include <AK/Vector.h>
+#include <LibCore/ConfigFile.h>
+#include <LibCore/Process.h>
+#include <LibDesktop/Launcher.h>
+#include <LibGfx/Bitmap.h>
+#include <LibGUI/Action.h>
+#include <LibGUI/FileIconProvider.h>
+#include <LibGUI/Icon.h>
+#include <LibGUI/Menu.h>
+#include <LibGUI/MessageBox.h>
+#include <LibGUI/Process.h>
+#include <LibGUI/Window.h>
+#include <LibURL/URL.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace Taskbar {
+
+namespace {
+
+using namespace Xdg;
+
+ByteString state_directory()
+{
+    if (auto const* dir = getenv("SDE_STATE_DIR"); dir && *dir)
+        return ByteString { dir };
+    if (auto const* config = getenv("XDG_CONFIG_HOME"); config && *config)
+        return ByteString::formatted("{}/sde", config);
+    if (auto const* home = getenv("HOME"); home && *home)
+        return ByteString::formatted("{}/.config/sde", home);
+    return ByteString { "/tmp/sde" };
+}
+
+static Optional<bool> read_config_bool(Core::ConfigFile& config, StringView group, StringView key)
+{
+    auto text = config.read_entry(group, key);
+    if (text.is_empty())
+        return {};
+    auto lower = text.trim_whitespace().to_lowercase();
+    if (lower == "true"sv || lower == "1"sv || lower == "yes"sv || lower == "on"sv)
+        return true;
+    if (lower == "false"sv || lower == "0"sv || lower == "no"sv || lower == "off"sv)
+        return false;
+    return {};
+}
+
+RefPtr<Gfx::Bitmap const> bitmap_for_icon_name(StringView icon)
+{
+    if (icon.is_empty())
+        return nullptr;
+
+    ByteString icon_string { icon };
+    if (icon.starts_with('/') || icon.contains("://"sv) || icon.starts_with("resource:"sv)) {
+        auto bitmap = Gfx::Bitmap::load_from_uri(icon_string);
+        if (!bitmap.is_error())
+            return bitmap.release_value();
+        return nullptr;
+    }
+
+    Vector<ByteString> candidates;
+    candidates.append(ByteString::formatted("resource://icons/16x16/{}.png", icon));
+    for (auto const& prefix : { "applications-"sv, "preferences-"sv, "kf5-"sv, "gnome-"sv }) {
+        if (icon.starts_with(prefix))
+            candidates.append(ByteString::formatted("resource://icons/16x16/{}.png", icon.substring_view(prefix.length())));
+    }
+    for (auto const& uri : candidates) {
+        auto bitmap = Gfx::Bitmap::load_from_uri(uri);
+        if (!bitmap.is_error())
+            return bitmap.release_value();
+    }
+    return nullptr;
+}
+
+RefPtr<Gfx::Bitmap const> icon_from_system_menu(StringView name)
+{
+    auto config = Core::ConfigFile::open("resource://icons/SystemMenu.ini"sv);
+    if (config.is_error())
+        return nullptr;
+
+    auto& file = *config.value();
+    auto lower_name = ByteString { name }.to_lowercase();
+    lower_name = lower_name.replace("&"sv, ""sv, ReplaceMode::All);
+    for (auto const& key : file.keys("16x16"sv)) {
+        auto label = key.replace("&"sv, ""sv, ReplaceMode::All);
+        if (label.to_lowercase() != lower_name)
+            continue;
+        auto path = file.read_entry("16x16"sv, key);
+        if (path.is_empty())
+            return nullptr;
+        auto uri = path.starts_with("/res/"sv) ? ByteString::formatted("resource://{}", path.substring_view(5)) : path;
+        auto bitmap = Gfx::Bitmap::load_from_uri(uri);
+        if (!bitmap.is_error())
+            return bitmap.release_value();
+    }
+    return nullptr;
+}
+
+RefPtr<Gfx::Bitmap const> icon_for_menu(MenuNode const& node, ByteString const& caption)
+{
+    if (node.directory.has_value()) {
+        if (auto bitmap = bitmap_for_icon_name(node.directory->icon); bitmap)
+            return bitmap;
+    }
+
+    if (auto bitmap = icon_from_system_menu(caption.view()); bitmap)
+        return bitmap;
+
+    auto lower = caption.to_lowercase();
+    if (lower == "multimedia"sv || lower == "sound & video"sv || lower == "media"sv)
+        return bitmap_for_icon_name("multimedia"sv);
+    if (lower == "system"sv || lower == "other"sv || lower == "accessories"sv)
+        return bitmap_for_icon_name("utilities"sv);
+    if (lower == "education"sv || lower == "science"sv)
+        return bitmap_for_icon_name("development"sv);
+    return bitmap_for_icon_name(lower);
+}
+
+RefPtr<Gfx::Bitmap const> icon_for_entry(DesktopEntry const& entry)
+{
+    if (auto bitmap = bitmap_for_icon_name(entry.icon); bitmap)
+        return bitmap;
+
+    if (entry.executable.is_empty())
+        return nullptr;
+    auto executable = resolve_executable(entry.executable).value_or(entry.executable);
+    auto icon = GUI::FileIconProvider::icon_for_path(executable.view());
+    return icon.bitmap_for_size(16);
+}
+
+void launch_entry(DesktopEntry const& entry, GUI::Window& window)
+{
+    if (entry.is_link) {
+        URL::URL url(entry.url);
+        if (!Desktop::Launcher::open(url))
+            GUI::MessageBox::show_error(&window, ByteString::formatted("Could not open '{}'", entry.url));
+        return;
+    }
+
+    if (entry.terminal) {
+        Vector<ByteString> arguments;
+        arguments.append("-e"_string.to_byte_string());
+        arguments.append(strip_field_codes(entry.exec));
+        GUI::Process::spawn_or_show_error(&window, "/bin/Terminal"sv, arguments.span());
+        return;
+    }
+
+    auto arguments = split_exec(entry.exec);
+    if (arguments.is_empty())
+        return;
+    auto program = arguments.take_first();
+    auto resolved = resolve_executable(program);
+    if (!resolved.has_value())
+        return;
+    GUI::Process::spawn_or_show_error(&window, resolved.value().view(), arguments.span());
+}
+
+ByteString caption_for(MenuNode const& node)
+{
+    return (node.directory.has_value() && !node.directory->name.is_empty()) ? node.directory->name : node.name;
+}
+
+// GUI menu labels use '&' as the mnemonic marker; XDG names are literal text.
+ByteString gui_text(ByteString const& text)
+{
+    StringBuilder builder;
+    for (auto character : text) {
+        if (character == '&')
+            builder.append("&&"sv);
+        else
+            builder.append(character);
+    }
+    return builder.to_byte_string();
+}
+
+struct MenuPlan;
+
+struct PlannedThing {
+    enum class Type {
+        Entry,
+        Separator,
+        Submenu,
+    };
+
+    Type type { Type::Separator };
+    DesktopEntry entry;
+    OwnPtr<MenuPlan> submenu;
+    MenuNode* node { nullptr };
+};
+
+struct MenuPlan {
+    ByteString caption;
+    Vector<PlannedThing> things;
+    Vector<ByteString> labels;
+    bool has_content { false };
+};
+
+struct ChildPlan {
+    ByteString name;
+    MenuNode* node { nullptr };
+    OwnPtr<MenuPlan> plan;
+};
+
+Layout const& effective_layout(MenuNode const& node, Optional<Layout> const& inherited_default)
+{
+    if (node.layout.has_value() && !node.layout->items.is_empty())
+        return node.layout.value();
+    if (node.default_layout.has_value()) {
+        if (!node.default_layout->items.is_empty())
+            return node.default_layout.value();
+    } else if (inherited_default.has_value() && !inherited_default->items.is_empty()) {
+        return inherited_default.value();
+    }
+
+    static auto builtin = [] {
+        Layout layout;
+        layout.items.append({ LayoutItem::Type::MergeMenus, {}, false });
+        layout.items.append({ LayoutItem::Type::MergeFiles, {}, false });
+        return layout;
+    }();
+    return builtin;
+}
+
+bool case_insensitive_less(ByteString const& a, ByteString const& b)
+{
+    return a.to_lowercase() < b.to_lowercase();
+}
+
+void build_plan(MenuNode& node, Optional<Layout> const& inherited_default, MenuPlan& plan)
+{
+    auto child_default = node.default_layout.has_value() ? node.default_layout : inherited_default;
+
+    Vector<ChildPlan> children;
+    for (auto& child : node.children) {
+        auto child_plan = make<MenuPlan>();
+        child_plan->caption = caption_for(*child);
+        build_plan(*child, child_default, *child_plan);
+        children.append({ child->name, child.ptr(), move(child_plan) });
+    }
+
+    Vector<DesktopEntry const*> entries;
+    for (auto& entry : node.entries)
+        entries.append(&entry);
+    quick_sort(entries, [](auto* a, auto* b) { return case_insensitive_less(a->name, b->name); });
+
+    HashTable<ByteString> used_entries;
+    HashTable<ByteString> used_children;
+    bool pending_separator = false;
+
+    auto flush_separator = [&] {
+        if (!pending_separator)
+            return;
+        plan.things.append({ PlannedThing::Type::Separator, {}, {}, nullptr });
+        plan.labels.append(ByteString { "---" });
+        pending_separator = false;
+    };
+
+    auto add_entry = [&](DesktopEntry const& entry) {
+        if (used_entries.contains(entry.id))
+            return;
+        flush_separator();
+        plan.things.append({ PlannedThing::Type::Entry, entry, {}, nullptr });
+        plan.labels.append(entry.name);
+        plan.has_content = true;
+        used_entries.set(entry.id);
+    };
+
+    auto add_child = [&](ChildPlan& child, bool show_empty) {
+        if (used_children.contains(child.name))
+            return;
+        if (!child.plan->has_content && !show_empty)
+            return;
+        flush_separator();
+        auto caption = child.plan->caption;
+        plan.things.append({ PlannedThing::Type::Submenu, {}, move(child.plan), child.node });
+        plan.labels.append(ByteString::formatted("[{}]", caption));
+        plan.has_content = true;
+        used_children.set(child.name);
+    };
+
+    auto const& layout = effective_layout(node, inherited_default);
+
+    for (auto const& item : layout.items) {
+        switch (item.type) {
+        case LayoutItem::Type::Entry: {
+            for (auto const* entry : entries) {
+                if (entry->id == item.value) {
+                    add_entry(*entry);
+                    break;
+                }
+            }
+            break;
+        }
+        case LayoutItem::Type::Menu: {
+            for (auto& child : children) {
+                if (child.name == item.value) {
+                    add_child(child, item.show_empty);
+                    break;
+                }
+            }
+            break;
+        }
+        case LayoutItem::Type::Separator:
+            if (!plan.things.is_empty())
+                pending_separator = true;
+            break;
+        case LayoutItem::Type::MergeMenus: {
+            Vector<ChildPlan*> remaining;
+            for (auto& child : children) {
+                if (!used_children.contains(child.name))
+                    remaining.append(&child);
+            }
+            quick_sort(remaining, [](auto* a, auto* b) { return case_insensitive_less(a->plan->caption, b->plan->caption); });
+            for (auto* child : remaining)
+                add_child(*child, layout.show_empty);
+            break;
+        }
+        case LayoutItem::Type::MergeFiles:
+            for (auto const* entry : entries) {
+                if (!used_entries.contains(entry->id))
+                    add_entry(*entry);
+            }
+            break;
+        case LayoutItem::Type::MergeAll: {
+            Vector<ChildPlan*> remaining_children;
+            for (auto& child : children) {
+                if (!used_children.contains(child.name))
+                    remaining_children.append(&child);
+            }
+            quick_sort(remaining_children, [](auto* a, auto* b) { return case_insensitive_less(a->plan->caption, b->plan->caption); });
+
+            Vector<DesktopEntry const*> remaining_entries;
+            for (auto const* entry : entries) {
+                if (!used_entries.contains(entry->id))
+                    remaining_entries.append(entry);
+            }
+
+            size_t child_index = 0;
+            size_t entry_index = 0;
+            while (child_index < remaining_children.size() || entry_index < remaining_entries.size()) {
+                bool take_child;
+                if (child_index >= remaining_children.size())
+                    take_child = false;
+                else if (entry_index >= remaining_entries.size())
+                    take_child = true;
+                else
+                    take_child = case_insensitive_less(remaining_children[child_index]->plan->caption, remaining_entries[entry_index]->name);
+                if (take_child)
+                    add_child(*remaining_children[child_index++], layout.show_empty);
+                else
+                    add_entry(*remaining_entries[entry_index++]);
+            }
+            break;
+        }
+        }
+    }
+
+    StringBuilder labels;
+    for (size_t i = 0; i < plan.labels.size(); ++i) {
+        if (i > 0)
+            labels.append(", "sv);
+        labels.append(plan.labels[i]);
+    }
+    dbgln("Taskbar: XDG menu '{}': {}", plan.caption, plan.labels.is_empty() ? "(empty)"sv : labels.string_view());
+}
+
+void render_plan(MenuPlan const& plan, GUI::Menu& menu, GUI::Window& window)
+{
+    for (auto const& thing : plan.things) {
+        switch (thing.type) {
+        case PlannedThing::Type::Separator:
+            menu.add_separator();
+            break;
+        case PlannedThing::Type::Entry: {
+            auto icon = icon_for_entry(thing.entry);
+            menu.add_action(GUI::Action::create(gui_text(thing.entry.name), icon, [entry = thing.entry, &window](auto&) {
+                launch_entry(entry, window);
+            }));
+            break;
+        }
+        case PlannedThing::Type::Submenu: {
+            auto submenu = menu.add_submenu(String::from_byte_string(gui_text(thing.submenu->caption)).release_value_but_fixme_should_propagate_errors());
+            render_plan(*thing.submenu, *submenu, window);
+            if (auto icon = icon_for_menu(*thing.node, thing.submenu->caption); icon)
+                submenu->set_icon(icon.ptr());
+            break;
+        }
+        }
+    }
+}
+
+ByteString menu_category_for(Vector<ByteString> const& categories)
+{
+    for (auto const& category : categories) {
+        if (category == "Development"sv)
+            return "D&evelopment"_string.to_byte_string();
+        if (category == "Game"sv || category == "Games"sv)
+            return "&Games"_string.to_byte_string();
+        if (category == "Graphics"sv || category == "Demos"sv || category == "Demo"sv)
+            return "Gra&phics"_string.to_byte_string();
+        if (category == "Network"sv)
+            return "&Internet"_string.to_byte_string();
+        if (category == "AudioVideo"sv || category == "Audio"sv || category == "Video"sv)
+            return "&Media"_string.to_byte_string();
+        if (category == "Office"sv)
+            return "&Office"_string.to_byte_string();
+        if (category == "Settings"sv)
+            return "Settings"_string.to_byte_string();
+        if (category == "System"sv || category == "Utility"sv)
+            return "&Utilities"_string.to_byte_string();
+    }
+    return "&Utilities"_string.to_byte_string();
+}
+
+void add_fallback_category_menu(GUI::Menu& system_menu, GUI::Window& window)
+{
+    auto entries = discover_entries();
+    HashMap<ByteString, Vector<DesktopEntry>> categories;
+    for (auto& entry : entries)
+        categories.ensure(menu_category_for(entry.categories)).append(move(entry));
+
+    static constexpr Array<StringView, 8> category_order {
+        "D&evelopment"sv,
+        "&Games"sv,
+        "Gra&phics"sv,
+        "&Internet"sv,
+        "&Media"sv,
+        "&Office"sv,
+        "Settings"sv,
+        "&Utilities"sv,
+    };
+
+    for (auto category : category_order) {
+        auto it = categories.find(category);
+        if (it == categories.end() || it->value.is_empty())
+            continue;
+
+        auto menu = system_menu.add_submenu(String::from_utf8(category).release_value_but_fixme_should_propagate_errors());
+        if (auto icon = icon_from_system_menu(category); icon)
+            menu->set_icon(icon.ptr());
+
+        auto& apps = it->value;
+        quick_sort(apps, [](auto const& a, auto const& b) { return case_insensitive_less(a.name, b.name); });
+        for (auto const& entry : apps) {
+            auto icon = icon_for_entry(entry);
+            menu->add_action(GUI::Action::create(entry.name, icon, [entry, &window](auto&) {
+                launch_entry(entry, window);
+            }));
+        }
+        dbgln("Taskbar: XDG fallback menu '{}': {} entries", category, apps.size());
+    }
+}
+
+}
+
+bool xdg_menu_enabled()
+{
+    // Layered like the compositor's config (Services/WindowServer/src/Config.cpp):
+    // the user's file first, then the SerenityOS defaults under the resource root.
+    // Keep the parsing in sync with that file so `sde-config` and the Taskbar
+    // cannot disagree about the value.
+    ByteString defaults_path;
+    if (auto const* root = getenv("SERENITY_RES_ROOT"); root && *root)
+        defaults_path = ByteString::formatted("{}/../etc/WindowServer.ini", root);
+    else
+        defaults_path = ByteString { "/etc/WindowServer.ini" };
+
+    auto const user_path = ByteString::formatted("{}/WindowServer.ini", state_directory());
+    for (auto const& path : { user_path, defaults_path }) {
+        auto config = Core::ConfigFile::open(path);
+        if (config.is_error())
+            continue;
+        if (auto value = read_config_bool(*config.value(), "Taskbar"sv, "XDGMenu"sv); value.has_value())
+            return value.value();
+    }
+    return false;
+}
+
+ErrorOr<void> add_xdg_apps_to_menu(GUI::Menu& system_menu, GUI::Window& window)
+{
+    auto loaded = TRY(load_menu());
+    if (!loaded) {
+        dbgln("Taskbar: no XDG menu file found; using the category fallback");
+        add_fallback_category_menu(system_menu, window);
+        return {};
+    }
+
+    auto plan = make<MenuPlan>();
+    plan->caption = caption_for(*loaded->root);
+    build_plan(*loaded->root, {}, *plan);
+    render_plan(*plan, system_menu, window);
+    return {};
+}
+
+}
