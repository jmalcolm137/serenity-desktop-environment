+++ b/Userland/Applications/Terminal/CMakeLists.txt
@@ -10,3 +10,11 @@ set(SOURCES
 
 serenity_app(Terminal ICON app-terminal)
 target_link_libraries(Terminal PRIVATE LibConfig LibCore LibFileSystem LibDesktop LibGfx LibGUI LibVT LibMain LibURL)
+
+# Serenity Desktop Environment: link the SDE system-compatibility library. The
+# SDE build passes -DSDE_ROOT; a plain libgui-wayland build leaves it undefined
+# and is unaffected.
+if (DEFINED SDE_ROOT AND NOT "${SDE_ROOT}" STREQUAL "")
+    add_subdirectory("${SDE_ROOT}/src/LibSerenitySystem" "${CMAKE_CURRENT_BINARY_DIR}/LibSerenitySystem")
+    target_link_libraries(Terminal PRIVATE SerenitySystem)
+endif()
