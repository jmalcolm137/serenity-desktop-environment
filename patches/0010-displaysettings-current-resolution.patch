diff --git a/Userland/Applications/DisplaySettings/MonitorSettingsWidget.cpp b/Userland/Applications/DisplaySettings/MonitorSettingsWidget.cpp
--- a/Userland/Applications/DisplaySettings/MonitorSettingsWidget.cpp
+++ b/Userland/Applications/DisplaySettings/MonitorSettingsWidget.cpp
@@ -77,6 +77,17 @@ ErrorOr<void> MonitorSettingsWidget::create_resolution_list()
         dbgln("EDID unavailable; Adding resolutions manually");
     }
 
+    // The current mode must be selectable even when the EDID is unavailable: the
+    // fallback list is generic and need not contain a panel's native resolution
+    // (e.g. 2560x1600). Without this the combo falls back to its first entry and
+    // reports a resolution the output is not actually using.
+    if (m_selected_screen_index < m_screen_layout.screens.size()) {
+        auto const& current_resolution = m_screen_layout.screens[m_selected_screen_index].resolution;
+        if (current_resolution.width() > 0 && current_resolution.height() > 0
+            && !m_resolutions.contains_slow(current_resolution))
+            TRY(m_resolutions.try_append(current_resolution));
+    }
+
     TRY(generate_resolution_strings());
     return {};
 }
