--- a/Meta/Lagom/CMakeLists.txt	2026-10-14 00:54:12.851672889 -0700
+++ b/Meta/Lagom/CMakeLists.txt	2026-10-14 00:54:12.854244025 -0700
@@ -631,6 +631,160 @@
         # fallback; loaded at runtime by LibGPU's driver).
         add_subdirectory("${SERENITY_PROJECT_ROOT}/../libeglgpu" "${CMAKE_CURRENT_BINARY_DIR}/libeglgpu")
         # ------------------------------------------------------------------
+        # libgui-wayland: the SerenityOS applications we support on the host,
+        # built from their own CMakeLists (the build system handles GML,
+        # stringify_gml and embedded resources). Applications that need the
+        # (disabled) LibWeb/LibWebView stack are omitted.
+        # ------------------------------------------------------------------
+        set(libgui_wayland_apps
+            About
+            AnalogClock
+            Assistant
+            Calendar
+            CalendarSettings
+            CertificateSettings
+            CharacterMap
+            ClockSettings
+            Escalator
+            FileManager
+            FontEditor
+            HexEditor
+            ImageViewer
+            MailSettings
+            MapsSettings
+            MouseSettings
+            NetworkSettings
+            PixelPaint
+            Run
+            Screenshot
+            Settings
+            SoundPlayer
+            SpaceAnalyzer
+            ThemeEditor
+            UsersSettings
+            VideoPlayer
+            Weather
+            3DFileViewer
+            # Second batch: needs the extra libraries added below.
+            KeyboardMapper
+            KeyboardSettings
+            GamesSettings
+            Maps
+            DisplaySettings
+            PartitionEditor
+            Terminal
+            TerminalSettings
+            SystemMonitor
+            CrashReporter
+            Debugger
+            # Web-stack apps (ENABLE_LAGOM_LIBWEB=ON).
+            Browser
+            BrowserSettings
+            Help
+            Mail
+            Presenter
+            Spreadsheet
+            TextEditor
+            Welcome
+        )
+        foreach(app ${libgui_wayland_apps})
+            add_serenity_subdirectory(Userland/Applications/${app})
+            # Link the two shims and keep them loaded (their portals are
+            # registered from static initializers).
+            target_link_options(${app} PRIVATE "-Wl,--no-as-needed")
+            target_link_libraries(${app} PRIVATE wm)
+            # Host compatibility headers (e.g. a stand-in errno_codes.h).
+            target_include_directories(${app} PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+            if (app STREQUAL "SystemMonitor")
+                # Serenity-specific mount flags and scheduler constant.
+                target_compile_definitions(${app} PRIVATE THREAD_PRIORITY_MAX=99 MS_WXALLOWED=0 MS_AXALLOWED=0 MS_NOREGULAR=0)
+            endif()
+        endforeach()
+        # libgui-wayland: the SerenityOS games. The Taskbar's "Games" menu is
+        # generated from the .af files under the resource root, so building the
+        # binaries (next to the Taskbar) is enough to surface them.
+        set(libgui_wayland_games
+            BrickGame
+            Chess
+            ColorLines
+            FlappyBug
+            Flood
+            GameOfLife
+            Hearts
+            MasterWord
+            Minesweeper
+            Snake
+            Solitaire
+            Spider
+            Sudoku
+        )
+        foreach(game ${libgui_wayland_games})
+            add_serenity_subdirectory(Userland/Games/${game})
+            target_link_options(${game} PRIVATE "-Wl,--no-as-needed")
+            target_link_libraries(${game} PRIVATE wm)
+            target_include_directories(${game} PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+        endforeach()
+        # The 2048 target's source directory is TwentyFourtyEight.
+        add_serenity_subdirectory(Userland/Games/TwentyFourtyEight)
+        target_link_options(2048 PRIVATE "-Wl,--no-as-needed")
+        target_link_libraries(2048 PRIVATE wm)
+        target_include_directories(2048 PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+        # Chess plays against this engine (spawned as a child process).
+        add_serenity_subdirectory(Userland/Services/ChessEngine)
+        # libgui-wayland: the SerenityOS developer tools (the Taskbar's
+        # Development menu).
+        set(libgui_wayland_devtools
+            GMLPlayground
+            HackStudio
+            Profiler
+            SQLStudio
+        )
+        foreach(tool ${libgui_wayland_devtools})
+            add_serenity_subdirectory(Userland/DevTools/${tool})
+            target_link_options(${tool} PRIVATE "-Wl,--no-as-needed")
+            target_link_libraries(${tool} PRIVATE wm)
+            target_include_directories(${tool} PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+        endforeach()
+        # libgui-wayland: the SerenityOS demos (the Taskbar's Demos menu).
+        set(libgui_wayland_demos
+            CatDog
+            Eyes
+            Gradient
+            LibGfxDemo
+            LibGfxScaleDemo
+            Mandelbrot
+            ModelGallery
+            Screensaver
+            Starfield
+            WidgetGallery
+        )
+        foreach(demo ${libgui_wayland_demos})
+            add_serenity_subdirectory(Userland/Demos/${demo})
+            target_link_options(${demo} PRIVATE "-Wl,--no-as-needed")
+            target_link_libraries(${demo} PRIVATE wm)
+            target_include_directories(${demo} PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+        endforeach()
+        # libgui-wayland: Magnifier (the Taskbar's Utilities menu).
+        add_serenity_subdirectory(Userland/Applications/Magnifier)
+        target_link_options(Magnifier PRIVATE "-Wl,--no-as-needed")
+        target_link_libraries(Magnifier PRIVATE wm)
+        target_include_directories(Magnifier PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+        # libgui-wayland: GL demo. Renders through the client-side LibGL/LibSoftGPU
+        # stack like 3DFileViewer; no GPU or compositor cooperation required.
+        add_serenity_subdirectory(Userland/Demos/Tubes)
+        target_link_options(Tubes PRIVATE "-Wl,--no-as-needed")
+        target_link_libraries(Tubes PRIVATE wm)
+
+        # Serenity Desktop Environment: the Taskbar. It is built when SDE_ROOT is
+        # set and links the WindowServer compatibility library only; the
+        # WindowServer serves the WindowManagerServer protocol itself.
+        if (DEFINED SDE_ROOT AND NOT "${SDE_ROOT}" STREQUAL "")
+            add_serenity_subdirectory(Userland/Services/Taskbar)
+            target_link_options(Taskbar PRIVATE "-Wl,--no-as-needed")
+            target_link_libraries(Taskbar PRIVATE windowserver)
+            target_include_directories(Taskbar BEFORE PRIVATE "${SDE_ROOT}/compat")
+            target_include_directories(Taskbar PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+        endif()
 
         # Lagom Utilities
         lagom_utility(abench SOURCES ../../Userland/Utilities/abench.cpp LIBS LibMain LibFileSystem LibAudio)
