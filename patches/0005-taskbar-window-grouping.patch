+WindowIdentifier const& TaskbarButton::primary_identifier() const
+{
+    // The window the button acts on: the group's active window if it has one,
+    // otherwise the first (oldest) window of the group.
+    for (auto const& identifier : m_identifiers) {
+        if (auto* window = WindowList::the().window(identifier); window && window->is_active())
+            return identifier;
+    }
+    return m_identifiers.first();
