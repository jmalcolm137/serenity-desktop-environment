+void QuickLaunchWidget::launch_entry(ByteString const& name)
+{
+    for (auto const& entry : m_entries) {
+        if (entry->name() != name)
+            continue;
+        if (auto result = entry->launch(); result.is_error())
+            GUI::MessageBox::show_error(window(), ByteString::formatted("Failed to open quick launch entry: {}", result.release_error()));
+        return;
+    }
+}
