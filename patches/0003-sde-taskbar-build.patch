--- a/Meta/Lagom/CMakeLists.txt
+++ b/Meta/Lagom/CMakeLists.txt
@@ -705,6 +705,17 @@
         target_link_options(Tubes PRIVATE "-Wl,--no-as-needed")
         target_link_libraries(Tubes PRIVATE wm serenity-audio)
 
+        # Serenity Desktop Environment: the Taskbar. It needs the SDE's
+        # WindowManagerServer shim, so it is only built when SDE_ROOT is set.
+        if (DEFINED SDE_ROOT AND NOT "${SDE_ROOT}" STREQUAL "")
+            add_subdirectory("${SDE_ROOT}/src/LibWindowManagerServer" "${CMAKE_CURRENT_BINARY_DIR}/serenity-desktop/LibWindowManagerServer")
+            add_serenity_subdirectory(Userland/Services/Taskbar)
+            target_link_options(Taskbar PRIVATE "-Wl,--no-as-needed")
+            target_link_libraries(Taskbar PRIVATE windowserver serenity-audio windowmanagerserver)
+            target_include_directories(Taskbar BEFORE PRIVATE "${SDE_ROOT}/compat")
+            target_include_directories(Taskbar PRIVATE "${SERENITY_PROJECT_ROOT}/../compat")
+        endif()
+
         # Lagom Utilities
         lagom_utility(abench SOURCES ../../Userland/Utilities/abench.cpp LIBS LibMain LibFileSystem LibAudio)
         lagom_utility(aconv SOURCES ../../Userland/Utilities/aconv.cpp LIBS LibMain LibFileSystem LibAudio)
