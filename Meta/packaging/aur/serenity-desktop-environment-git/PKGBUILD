# Maintainer: Serenity Desktop Environment contributors
#
# The compositor, services and session half of the split. It builds against the
# framework package (serenity-lagom-git) with SDE_PREBUILT_FRAMEWORK=ON, and
# installs only its own binaries/scripts; the framework package owns bin/lib/share.

pkgname=serenity-desktop-environment-git
pkgver=0.1.0
pkgrel=1
pkgdesc="The SerenityOS desktop experience on Wayland (compositor, shell and services)"
arch=('x86_64')
url="https://github.com/jmalcolm137/serenity-desktop-environment"
license=('BSD-2-Clause')
provides=('serenity-desktop-environment')
conflicts=('serenity-desktop-environment')
depends=(
    'serenity-lagom-git'
    wayland libdrm libinput libxkbcommon pixman seatd libxcb xcb-util-wm
    libdisplay-info pipewire libpipewire dbus glib2 fontconfig freetype2
    libunwind libelf libei libliftoff wlroots0.20 xorg-xwayland
    polkit python-gobject
)
optdepends=('sddm: display manager that lists the SDE Wayland session')
makedepends=(
    'serenity-lagom-git' wlroots0.20
    base-devel cmake ninja meson pkgconf git python wayland-protocols
    libpulse zip unzip patchelf
)
source=(
    "serenity-desktop-environment::git+https://github.com/jmalcolm137/serenity-desktop-environment.git#tag=v0.1.0"
)
sha256sums=('SKIP')

pkgver() {
    if [[ -n ${SDE_RELEASE_VERSION:-} ]]; then
        printf '%s' "$SDE_RELEASE_VERSION"
        return 0
    fi
    cd "$srcdir/serenity-desktop-environment"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/serenity-desktop-environment"
    export SDE_PREBUILT_FRAMEWORK=ON
    # build-target.sh reads these unsuffixed names and passes them to CMake.
    # The framework package installs the libgui-wayland source/header tree at
    # /usr/lib/sde/framework, so the SDE build must not look for a sibling
    # libgui-wayland checkout that does not exist in an AUR $srcdir.
    export LIBGUI_WAYLAND_ROOT=/usr/lib/sde/framework
    export SDE_LIBGUI_WAYLAND_ROOT=/usr/lib/sde/framework
    export SDE_LAGOM_BUILD_DIR=/usr/lib/sde
    export SDE_SERENITY_BUILD_DIR=/usr/lib/sde/framework
    export SDE_SERENITY_SRC=/usr/lib/sde/framework/serenity
    export SERENITY_SRC="$SDE_SERENITY_SRC"
    export BUILD="$SDE_LAGOM_BUILD_DIR"
    export WLROOTS_SRC="$srcdir/serenity-desktop-environment/third_party/wlroots"
    scripts/build-full-sde.sh
}

package() {
    cd "$srcdir/serenity-desktop-environment"
    export BUILD=/usr/lib/sde
    export SERENITY=/usr/lib/sde/framework/serenity
    scripts/install-sde.sh --destdir "$pkgdir" --prefix /usr/lib/sde --without-framework

    # The compositor is linked against the staging wlroots checkout, so its
    # build RUNPATH contains the AUR $srcdir. Replace it with the installed
    # framework location; the system loader still supplies libwlroots.
    patchelf --set-rpath /usr/lib/sde/lib "$pkgdir/usr/lib/sde/bin/WindowServer"

    install -Dm644 "$srcdir/serenity-desktop-environment/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
